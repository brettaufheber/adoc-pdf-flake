gem "asciidoctor-multipage", "= 0.0.19"
gem "asciidoctor-reducer", "~> 1.1.2"
gem "asciidoctor-revealjs", "~> 5.2.0"

# Asciidoctor extensions
gem "asciidoctor-html5s", "= 0.5.1"
gem "asciidoctor-bibtex", "~> 0.9.0"
gem "asciidoctor-mathematical", "= 0.3.5"
gem "asciidoctor-kroki", "~> 1.0.0"
gem "asciidoctor-lists", "~> 1.1.2"
#gem "asciidoctor-lists-extended", "~> 1.1.7"
#gem "asciidoctor-diagram", "~> 3.2.1"

# Source-code syntax highlighters supported by Asciidoctor
