gem "pygments.rb", "~> 4.0.0"
gem "rouge", "~> 4.7.0"

# GraphicsMagick integration for additional image-processing capabilities
gem "prawn-gmagick", "= 0.0.9"

# Language-aware automatic hyphenation
gem "text-hyphen", "~> 1.5.0"

# Explicit runtime dependency required by libraries that use decimal arithmetic
